<Application x:Class="StudyBlocker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light">
    <Application.Resources>
        <!-- The palette shared with the extension (theme.css), picked with Tinta on
             2026-11-21: neutral greys, brand blue #2563C9 dominant, coral #B24D39 as the
             complementary "blocked" accent, amber for warnings. Always light, like the
             extension. These override the Fluent theme's own brushes of the same names;
             every text pair passes WCAG AA. -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9" />
        <SolidColorBrush x:Key="BlockedSignBrush" Color="#B24D39" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2563C9" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2563C9" Opacity="0.9" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2563C9" Opacity="0.8" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#2563C9" />
        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#2563C9" />
        <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#2563C9" />
        <!-- The accent button reads its own keys rather than the AccentFill ones. -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#2563C9" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2563C9" Opacity="0.9" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2563C9" Opacity="0.8" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" Opacity="0.9" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF" Opacity="0.9" />
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1E2329" />
        <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4A525C" />
        <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#636B75" />
        <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#B24D39" />
        <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFF3DC" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Grey example text inside an empty text box; WPF's TextBox has no placeholder of its own. -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- The "+" / "−" that folds a "Hide on YouTube" switch's sub-options. A template of its
             own: the theme's button draws a filled box around anything. -->
        <Style x:Key="ExpandButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="Transparent">
                            <ContentPresenter TextElement.FontSize="20" TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A Windows 11 style on/off switch; WPF has no toggle switch of its own. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid x:Name="Toggle" Width="40" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <!-- Faded rather than greyed, so a switch held on by a lock still reads as on. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Toggle" Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
