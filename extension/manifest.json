{
  "manifest_version": 3,
  "name": "Smart Study Distraction Blocker",
  "version": "0.11.1",
  "description": "Classifies YouTube videos as study or distraction, showing an in-page block screen or grey-zone popup, hides distracting page surfaces per the Declutter checklist, shows its own page for blocked sites, and talks to the Smart Study Distraction Blocker service over native messaging.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "tabs", "alarms", "webNavigation"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Study Distraction Blocker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/shorts-guard.js", "content/overlay.js", "content/youtube.js", "content/declutter.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
